{
  "compilerOptions": {
    "outDir": "../.tmp-acc",
    "module": "commonjs",
    "target": "es2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "baseUrl": "..",
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "certification-acceptance.ts",
    "../lib/certification.ts",
    "../lib/certification-server.ts"
  ]
}
