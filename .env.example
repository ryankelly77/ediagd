# ============================================================================
# EDIAGD — environment variables, by name. NO VALUES, EVER.
#
# ---------------------------------------------------------------------------
# WHAT THIS FILE COVERS, AND WHAT IT DOES NOT. READ THIS BEFORE TRUSTING IT
# ---------------------------------------------------------------------------
# THIS IS NOT THE COMPLETE LIST and must not be read as one. It documents the
# NOTIFICATION AND LINK variables — the ones whose absence is SILENT, because
# every one of them is best-effort by design: a missing Slack webhook logs one
# warning and the action it was hung off succeeds anyway. Nothing breaks, so
# nothing tells you.
#
# The code reads around forty names in total, including Supabase, Mux, APNS,
# Resend, the cron secret and the watch-ticket secret, plus a dozen that only
# exist for a script's command line. A file claiming to be all of them while
# holding a third would be worse than this one: an incomplete list presented as
# complete is the failure mode AGENTS.md calls a sample reported as a general
# measurement.
#
# THE COMPLETE LIST IS DERIVED, NOT MAINTAINED HERE — a maintained copy drifts
# and nobody finds out:
#
#     grep -rhoE 'process\.env\.[A-Z0-9_]+' --include=*.ts --include=*.tsx \
#       app lib components scripts | sed 's/process\.env\.//' | sort -u
#
# Values live in Vercel's project settings and in `.env.local`, which is
# gitignored and stays that way.
# ============================================================================

# ---- Where this deploy lives -----------------------------------------------
# The public origin, no trailing slash. Every absolute link the server builds
# reads it — the certificate page, the ingest reports, and the #ediagd story
# notice. Defaults to https://app.ediagd.ai when unset, so a wrong value is
# worse than a missing one.
NEXT_PUBLIC_APP_URL=

# ---- Slack incoming webhooks ------------------------------------------------
# One POST of { text } each; see lib/slack/send.ts. All three are best-effort:
# unset means one console warning and no post, never a failed action.

# #ediagd — a notice when an advisor files a Good News Story. Who, which store,
# which track, and a link to /admin/stories. NEVER the story's words: Slack sits
# outside the RLS and a story is an HR surface (0180, lib/story-slack.ts).
SLACK_STORY_WEBHOOK=

# #ediagd — the daily Rollcall post.
SLACK_ROLLCALL_WEBHOOK=

# Where advisor feedback lands, with its context lines. This one DOES carry the
# advisor's words, because feedback is a support ticket somebody has to answer.
SLACK_FEEDBACK_WEBHOOK=
