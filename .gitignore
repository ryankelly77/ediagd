# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# offline engine scenarios
.tmp-test

# Build artefact from npm run check:nav
.tmp-nav/

# tsc scratch output from the script runners in package.json
.tmp-dms/

# tsc scratch output from the one-off script runners
.tmp-cm/
.tmp-remap/

# generated decision sheets — data, not code
exports/
.tmp-exp/

# ---- Capacitor native projects (generated by `npm run native:add`) ----------
# These are scaffolded from a template and re-created on demand; the things
# worth keeping live in native/ and are copied in by scripts/native-sync.sh.
/ios/
/android/
.tmp-push/
.tmp-cat/
.tmp-dv/
.tmp-rv/
