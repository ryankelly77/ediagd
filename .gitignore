exports/

# ---- Capacitor native projects -------------------------------------------
# ANDROID is still generated on demand: scaffolded from a template, re-created
# by `npm run native:add`, with the things worth keeping living in native/ and
# copied back in by scripts/native-sync.sh.
#
# IOS IS COMMITTED, and that is a reversal of the line above, made for
# TestFlight. Shipping a build requires hand edits INSIDE ios/ that no template
# regenerates and no sync script replaces: the export-compliance key, the
# version and build numbers, and — once Ryan signs in Xcode — the signing team
# and provisioning profile. Under the old rule every one of those was one
# `cap add` away from being silently lost, and the loss would surface as a
# rejected upload rather than a broken build.
#
# What stays ignored is listed in ios/.gitignore, which is Capacitor's own:
# build output, and the two files `cap sync` regenerates from
# capacitor.config.ts (App/App/capacitor.config.json and App/App/public). After
# a fresh clone, run `npx cap sync ios` before archiving.
/android/
.metric-snapshots/

# Pre-migration pg_dumps. Production data — never commit these.
.backups/

# Database dumps taken before destructive content writes. Large, and not ours to publish.
backups/

# Local Python env for the Drop Zone transcription (faster-whisper).
# Not a dependency of the app; see scripts/transcribe-dropzone.py.
.venv-whisper/

# ---- tsc scratch output from the script runners ---------------------------
# ONE GLOB, NOT A LINE PER SUITE. This was 61 individually-listed directories,
# and eight still slipped through and got committed — .tmp-cl, .tmp-ss and six
# more — because a new `npm run test:*` mints a new .tmp-<x>/ and the ignore
# list only learns about it if somebody remembers. The list was the bug.
#
# These are build output: `rm -rf` at the top of every script that makes one.
.tmp-*/
.tmp-test

# DMS exports from the dealer group. Real operational data — advisor names,
# labour sales, gross profit by rooftop — and 1-3MB apiece. Kept locally to
# test the parser against formats the vendor changes without telling us, but
# never pushed. The master workbooks in data/ ARE tracked, deliberately: they
# are the only recovery source for an import truncation, and they carry no
# customer or payroll data.
data/Doggett_Key_Maintenance_Sales_*.xlsx
data/KeyMaintenanceSales_*.xlsx

# Anything dropped into data/ for a look rather than to be kept.
#
# Video masters are multi-megabyte and the real ones live in Mux — the repo is
# not where a 4K master belongs. Screenshots land here the same way: a 2.9MB
# phone capture sat untracked in data/ for three days, one `git add -A` away
# from being committed forever, and nothing would have caught it.
#
# The xlsx rules above exclude named customer data. These exclude size.
data/*.MOV
data/*.mov
data/*.mp4
data/*.png
data/*.jpg
data/*.jpeg
data/*.heic
